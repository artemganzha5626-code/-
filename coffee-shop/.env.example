# ─────────────────────────────────────────────────────────────
#  BENCH — змінні середовища
# ─────────────────────────────────────────────────────────────
# Скопіюйте цей файл у .env.local та заповніть значення.
# Без Supabase сайт працює на красивих демо-даних (read-only).
# З Supabase — вмикається реальний контент і адмін-панель /admin.

# Публічний URL проєкту (для SEO / Open Graph / sitemap).
NEXT_PUBLIC_SITE_URL=https://bench-coffee.example.com

# ── Supabase ──────────────────────────────────────────────────
# Знайти у Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Тільки для серверних дій адмінки (НЕ додавати префікс NEXT_PUBLIC_).
# Знайти у Supabase Dashboard → Project Settings → API → service_role.
# Не комітьте цей ключ у git!
SUPABASE_SERVICE_ROLE_KEY=

# Назва бакета Supabase Storage для фотографій (створіть публічний бакет).
NEXT_PUBLIC_SUPABASE_BUCKET=bench-media
