# ===== CRMino_bot — пример переменных окружения =====
# Скопируйте в .env и заполните реальными значениями. .env НЕ коммитить!

# --- Telegram (обязательно) ---
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAaBbCc-YourTelegramBotTokenHere
# ID чата/группы менеджеров, куда падают карточки лидов.
# Узнать: добавьте бота в группу и посмотрите update, либо напишите @userinfobot.
# Для группы ID обычно отрицательный, например -1001234567890.
MANAGER_CHAT_ID=-1001234567890
# Обещанное пользователю время ответа менеджера (в минутах)
MANAGER_RESPONSE_MINUTES=15

# --- База данных ---
# MVP по умолчанию — SQLite (файл создастся автоматически):
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# Для PostgreSQL (когда будете мигрировать):
# DATABASE_URL=postgresql+asyncpg://crmino:crmino@db:5432/crmino

# --- CRM: Google Sheets (опционально) ---
# Если не заполнить — бот работает без записи в таблицу
# (лиды всё равно сохраняются в БД и уходят менеджеру).
# Путь к JSON сервис-аккаунта Google:
GOOGLE_CREDENTIALS_FILE=./credentials/google-service-account.json
# ID таблицы из URL: docs.google.com/spreadsheets/d/<ЭТОТ_ID>/edit
GOOGLE_SHEET_ID=
# Название листа внутри таблицы
GOOGLE_SHEET_WORKSHEET=Leads

# --- Таймауты / надёжность ---
# Максимум ожидания внешнего сервиса (сек). По ТЗ — не больше 3.
EXTERNAL_TIMEOUT=3.0
# Период фоновой досинхронизации очереди pending_sync (сек)
SYNC_INTERVAL=60

# --- Rate limiting ---
# Минимальный интервал между обрабатываемыми апдейтами одного юзера (сек)
THROTTLE_RATE=0.5

# --- Логирование ---
LOG_LEVEL=INFO
